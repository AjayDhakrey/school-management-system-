{
  "name": "schoolsphere-hub-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test:security": "node scripts/security-check.mjs",
    "test:academic": "node scripts/academic-check.mjs",
    "test:students": "node scripts/student-admission-check.mjs",
    "test:employees": "node scripts/employee-check.mjs",
    "test:attendance": "node scripts/attendance-check.mjs",
    "migrate:pg": "tsx src/db/migrate-pg.ts",
    "migrate:data": "node scripts/migrate-sqlite-to-postgres.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3"
  }
}
