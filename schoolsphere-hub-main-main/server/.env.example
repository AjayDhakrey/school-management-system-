NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:5173

# --- Database driver -------------------------------------------------------
# "sqlite"  -> local file (server/data.sqlite3), the original dev default
# "postgres" -> Supabase PostgreSQL via DATABASE_URL below
DB_DRIVER=sqlite

# Used only when DB_DRIVER=sqlite
DATABASE_PATH=./data.sqlite3

# --- Supabase PostgreSQL (only when DB_DRIVER=postgres) -------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Use the "Connection pooling" (Supavisor, port 6543) string for the app;
# the "Session"/direct (port 5432) string for migrations if pooling refuses DDL.
#   postgresql://postgres.<ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Supabase always needs TLS; leave true. Set false only for a local Postgres without SSL.
DATABASE_SSL=true
PG_POOL_MAX=10

# NEVER put the Supabase service-role key or DB password in any VITE_* variable —
# those are bundled into the browser build. The frontend only needs VITE_API_URL.
